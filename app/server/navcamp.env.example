# NavCamp VPS environment variables
# Copy to /etc/navcamp.env on the server, then fill in real values.
# Permissions: chmod 600 /etc/navcamp.env

PORT=3000

# Paystack secret key (from your Paystack dashboard → Settings → API Keys)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# Firebase project ID (e.g. navcamp-12345)
PROJECT_ID=your-firebase-project-id

# Firebase Web API key (from Firebase console → Project Settings → General)
FIREBASE_WEB_API_KEY=AIzaSy...

# Service account email (from Firebase console → Project Settings → Service Accounts)
SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Service account private key — paste the full PEM, replace real newlines with \n
# e.g.: -----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----
SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----
