{
  "name": "navcamp",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@vercel/analytics": "^2.0.1",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "^58.0.8",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "lucide-react-native": "^1.58.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.14"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "map:validate": "node scripts/campus-map.js validate",
    "map:export": "node scripts/campus-map.js export",
    "indoor-editor": "node tools/indoor-editor/server.js",
    "admin": "node tools/indoor-editor/server.js",
    "test": "node node_modules/jest-expo/bin/jest.js --no-coverage --transformIgnorePatterns \"node_modules/(?!(fuse\\.js))\""
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(fuse\\.js)/)"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/node_modules/react-native/Libraries/react-native/react-native-implementation",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "^0.88.0",
    "babel-jest": "^30.5.2",
    "babel-preset-expo": "^58.0.17",
    "jest": "^29.7.0",
    "jest-expo": "^58.0.11"
  }
}
